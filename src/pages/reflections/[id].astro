---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ornament from '../../components/Ornament.astro';

export async function getStaticPaths() {
	const reflections = await getCollection('reflections');
	return reflections.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.title}>
	<header class="page-hero">
		<h1>{post.data.title}</h1>
		<Ornament />
		<p>
			{post.data.date.toLocaleDateString('en-US', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})}
		</p>
	</header>

	<section class="section">
		<article class="prose panel reveal">
			<Content />
			<p style="margin-top: 2rem;">
				<a href="/reflections/">← All Reflections</a>
			</p>
		</article>
	</section>
</BaseLayout>
